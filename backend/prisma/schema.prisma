generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Company {
  id        String    @id @default(uuid())
  code      String    @unique
  name      String
  phone     String?
  email     String?
  logo      String?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  branches  Branch[]
  payrolls  Payroll[]
}

model Branch {
  id          String       @id @default(uuid())
  code        String       @unique
  name        String
  companyId   String
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt
  company     Company      @relation(fields: [companyId], references: [id])
  departments Department[]
  employees   Employee[]
  holidays    Holiday[]
  shifts      Shift[]
  payrolls    Payroll[]
}

model Department {
  id           String        @id @default(uuid())
  code         String        @unique
  name         String
  branchId     String
  branch       Branch        @relation(fields: [branchId], references: [id])
  designations Designation[]
}

model Designation {
  id           String     @id @default(uuid())
  code         String     @unique
  name         String
  departmentId String
  department   Department @relation(fields: [departmentId], references: [id])
  employees    Employee[]
}

model Employee {
  id              String           @id @default(uuid())
  employeeCode    String           @unique
  firstName       String
  lastName        String?
  mobile          String           @unique
  email           String?
  status          EmployeeStatus   @default(ACTIVE)
  branchId        String
  designationId   String
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt
  shiftId         String?
  attendance      Attendance[]
  leaves          Leave[]
  branch          Branch           @relation(fields: [branchId], references: [id])
  designation     Designation      @relation(fields: [designationId], references: [id])
  shift           Shift?           @relation("EmployeeShift", fields: [shiftId], references: [id])
  user            User?
  salaryStructure SalaryStructure?
  payrolls        Payroll[]
  allowances      Allowance[]
  deductions      Deduction[]
  bonuses         Bonus[]
  incentives      Incentive[]
  advanceSalaries AdvanceSalary[]
  loans           Loan[]

  @@index([shiftId])
}

model User {
  id         String    @id @default(uuid())
  mobile     String    @unique
  password   String
  role       UserRole
  isActive   Boolean   @default(true)
  employeeId String?   @unique
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt
  employee   Employee? @relation(fields: [employeeId], references: [id])
}

model Attendance {
  id                String            @id @default(uuid())
  employeeId        String
  date              DateTime          @db.Date
  checkIn           DateTime?
  checkOut          DateTime?
  workingMinutes    Int               @default(0)
  breakMinutes      Int               @default(0)
  overtimeMinutes   Int               @default(0)
  lateMinutes       Int               @default(0)
  earlyExitMinutes  Int               @default(0)
  status            AttendanceStatus
  remarks           String?
  netWorkingMinutes Int               @default(0)
  createdAt         DateTime          @default(now())
  updatedAt         DateTime          @default(now()) @updatedAt
  employee          Employee          @relation(fields: [employeeId], references: [id])
  breaks            AttendanceBreak[]

  @@unique([employeeId, date])
  @@index([employeeId, status])
  @@index([date, status])
}

model AttendanceBreak {
  id           String     @id @default(uuid())
  attendanceId String
  breakOut     DateTime
  breakIn      DateTime?
  minutes      Int        @default(0)
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @default(now()) @updatedAt
  attendance   Attendance @relation(fields: [attendanceId], references: [id], onDelete: Cascade)

  @@index([attendanceId, breakIn])
}

model Shift {
  id        String     @id @default(uuid())
  name      String
  startTime String
  endTime   String
  branchId  String
  employees Employee[] @relation("EmployeeShift")
  branch    Branch     @relation(fields: [branchId], references: [id])

  @@unique([branchId, name])
}

model Holiday {
  id       String   @id @default(uuid())
  title    String
  date     DateTime
  branchId String
  branch   Branch   @relation(fields: [branchId], references: [id])
}

model Leave {
  id          String @id @default(uuid())
  employeeId  String
  leaveNumber String @unique

  leaveType LeaveType
  status    LeaveStatus @default(PENDING)

  fromDate  DateTime @db.Date
  toDate    DateTime @db.Date
  totalDays Float

  isHalfDay      Boolean @default(false)
  halfDaySession String?

  reason          String
  remarks         String?
  rejectionReason String?

  approvedBy String?
  approvedAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  employee Employee @relation(fields: [employeeId], references: [id])

  @@index([employeeId])
  @@index([status])
  @@index([leaveType])
  @@index([fromDate, toDate])
}

enum UserRole {
  SUPER_ADMIN
  COMPANY_ADMIN
  HR_MANAGER
  HR_EXECUTIVE
  MANAGER
  TEAM_LEAD
  EMPLOYEE
}

enum EmployeeStatus {
  ACTIVE
  INACTIVE
  NOTICE
  RESIGNED
  TERMINATED
}

enum AttendanceStatus {
  PRESENT
  ABSENT
  HALF_DAY
  LEAVE
  HOLIDAY
  WEEK_OFF
}

enum LeaveType {
  CASUAL
  SICK
  EARNED
  UNPAID
  MATERNITY
  PATERNITY
  COMP_OFF
}

enum LeaveStatus {
  PENDING
  APPROVED
  REJECTED
  CANCELLED
}

enum PayrollStatus {
  DRAFT
  APPROVED
  LOCKED
  PAID
}

enum PayrollItemType {
  EARNING
  DEDUCTION
  OVERTIME
  BONUS
  INCENTIVE
}

enum PayrollHistoryAction {
  GENERATED
  APPROVED
  LOCKED
  UNLOCKED
  REGENERATED
  MODIFIED
  DELETED
}

enum SalaryStructureStatus {
  ACTIVE
  INACTIVE
}

enum AdvanceStatus {
  PENDING
  PARTIALLY_DEDUCTED
  COMPLETED
}

enum LoanStatus {
  ACTIVE
  CLOSED
  DEFAULTED
}

model SalaryStructure {
  id         String                @id @default(uuid())
  employeeId String                @unique
  status     SalaryStructureStatus @default(ACTIVE)
  createdAt  DateTime              @default(now())
  updatedAt  DateTime              @updatedAt
  createdBy  String?
  updatedBy  String?

  employee  Employee         @relation(fields: [employeeId], references: [id])
  revisions SalaryRevision[]

  @@index([employeeId])
}

model SalaryRevision {
  id                String    @id @default(uuid())
  salaryStructureId String
  version           Int
  effectiveFrom     DateTime
  effectiveTo       DateTime?
  components        Json
  notes             String?
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt
  createdBy         String?
  updatedBy         String?

  salaryStructure SalaryStructure @relation(fields: [salaryStructureId], references: [id])

  @@index([salaryStructureId, version])
}

model SalaryComponent {
  id            String          @id @default(uuid())
  name          String
  type          PayrollItemType
  defaultAmount Float
  isPercentage  Boolean         @default(false)
  createdAt     DateTime        @default(now())
  updatedAt     DateTime        @updatedAt
  createdBy     String?
  updatedBy     String?
}

model Payroll {
  id              String        @id @default(uuid())
  month           String
  employeeId      String
  companyId       String?
  branchId        String?
  gross           Float
  totalDeductions Float
  net             Float
  status          PayrollStatus @default(DRAFT)
  approvedAt      DateTime?
  lockedAt        DateTime?
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt
  createdBy       String?
  updatedBy       String?

  employee         Employee          @relation(fields: [employeeId], references: [id])
  company          Company?          @relation(fields: [companyId], references: [id])
  branch           Branch?           @relation(fields: [branchId], references: [id])
  items            PayrollItem[]
  payslip          Payslip?
  payrollApprovals PayrollApproval[]
  payrollHistories PayrollHistory[]

  @@unique([employeeId, month])
  @@index([month])
  @@index([status])
}

model PayrollItem {
  id          String          @id @default(uuid())
  payrollId   String
  type        PayrollItemType
  name        String
  amount      Float
  referenceId String?
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt
  createdBy   String?
  updatedBy   String?

  payroll Payroll @relation(fields: [payrollId], references: [id], onDelete: Cascade)

  @@index([payrollId])
}

model Allowance {
  id           String   @id @default(uuid())
  employeeId   String?
  name         String
  amount       Float
  isPercentage Boolean  @default(false)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  createdBy    String?
  updatedBy    String?

  employee Employee? @relation(fields: [employeeId], references: [id])
}

model Deduction {
  id           String   @id @default(uuid())
  employeeId   String?
  name         String
  amount       Float
  isPercentage Boolean  @default(false)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  createdBy    String?
  updatedBy    String?

  employee Employee? @relation(fields: [employeeId], references: [id])
}

model Bonus {
  id         String   @id @default(uuid())
  employeeId String
  amount     Float
  reason     String?
  month      String
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
  createdBy  String?
  updatedBy  String?

  employee Employee @relation(fields: [employeeId], references: [id])
}

model Incentive {
  id         String   @id @default(uuid())
  employeeId String
  amount     Float
  reason     String?
  month      String
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
  createdBy  String?
  updatedBy  String?

  employee Employee @relation(fields: [employeeId], references: [id])
}

model AdvanceSalary {
  id             String        @id @default(uuid())
  employeeId     String
  amount         Float
  deductedAmount Float         @default(0)
  dueMonth       String?
  status         AdvanceStatus @default(PENDING)
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt
  createdBy      String?
  updatedBy      String?

  employee Employee @relation(fields: [employeeId], references: [id])
}

model Loan {
  id                 String     @id @default(uuid())
  employeeId         String
  principal          Float
  outstanding        Float
  monthlyInstallment Float
  startDate          DateTime
  endDate            DateTime?
  status             LoanStatus @default(ACTIVE)
  createdAt          DateTime   @default(now())
  updatedAt          DateTime   @updatedAt
  createdBy          String?
  updatedBy          String?

  employee Employee @relation(fields: [employeeId], references: [id])
}

model Payslip {
  id        String   @id @default(uuid())
  payrollId String   @unique
  content   Json
  pdfPath   String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  payroll Payroll @relation(fields: [payrollId], references: [id], onDelete: Cascade)
}

model PayrollApproval {
  id         String   @id @default(uuid())
  payrollId  String
  approverId String
  remarks    String?
  createdAt  DateTime @default(now())

  payroll Payroll @relation(fields: [payrollId], references: [id], onDelete: Cascade)
}

model PayrollHistory {
  id        String               @id @default(uuid())
  payrollId String
  action    PayrollHistoryAction
  actorId   String?
  remarks   String?
  createdAt DateTime             @default(now())

  payroll Payroll @relation(fields: [payrollId], references: [id], onDelete: Cascade)
}
